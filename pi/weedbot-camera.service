# Starts pi_server.py at boot and restarts it if it exits.
# Install: see pi/README.md
[Unit]
Description=Weedbot camera relay (ESP32 USB -> MJPEG over HTTP)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/weedbot/pi_server.py /dev/ttyACM0 8000
Restart=always
RestartSec=2
# Throwaway system user with serial port access; no login account needed.
DynamicUser=yes
SupplementaryGroups=dialout
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
